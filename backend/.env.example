# PostgreSQL connection string
# Example:
# DATABASE_URL=postgresql+psycopg2://username:password@host:5432/dbname
DATABASE_URL=

# Firebase Admin SDK — path to the service account JSON (never commit the file itself)
FIREBASE_SERVICE_ACCOUNT_PATH=

# OTP delivery
# OTP_DEV_MODE=true (default): every OTP is 123456, logged to console, no SMS sent.
# Set to false ONLY once MSG91_AUTH_KEY + MSG91_TEMPLATE_ID below are configured with a
# DLT-registered template — required by Indian telecom regulation for any transactional/OTP
# SMS, independent of which provider you use. Without DLT registration, MSG91 will reject
# every send even with a valid API key.
OTP_DEV_MODE=true
OTP_EXPIRY_MINUTES=10

# MSG91 (https://msg91.com) — only needed when OTP_DEV_MODE=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Must match the variable name inside your DLT-approved template (MSG91 shows this
# when you create the template in their dashboard, e.g. "OTP" or "VAR1").
MSG91_OTP_VAR=OTP
